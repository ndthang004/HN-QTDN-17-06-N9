<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_van_ban_tree" model="ir.ui.view">
        <field name="name">van.ban.tree</field>
        <field name="model">van_ban</field>
        <field name="arch" type="xml">
            <tree>
                <field name="so_van_ban"/>
                <field name="tieu_de"/>
                <field name="ngay_tao"/>
                <field name="loai_van_ban"/>
                <field name="trang_thai"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_van_ban_form" model="ir.ui.view">
        <field name="name">van.ban.form</field>
        <field name="model">van_ban</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="so_van_ban"/>
                        <field name="tieu_de"/>
                        <field name="ngay_tao"/>
                        <field name="loai_van_ban"/>
                        <field name="trang_thai"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_van_ban" model="ir.actions.act_window">
        <field name="name">Văn bản</field>
        <field name="res_model">van_ban</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_van_ban_root"
              name="Quản lý văn bản"/>

    <menuitem id="menu_van_ban"
              parent="menu_van_ban_root"
              action="action_van_ban"
              name="Danh sách văn bản"/>

</odoo>
